{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleResolution": "node"
  },
  "include": [
    "src/ゲーム例/**/*",
    "src/データ/**/*",
    "src/インタフェース/**/*",
    "src/効果処理/**/*",
    "src/main.ts",
    "src/index.html"
  ],
  "exclude": ["node_modules", "dist", "src/サーバー/**/*"]
}
